# Optional overrides for the dev (hot-reload) stack.
# Copy to deploy/dev/docker/.env — the stack also starts without it,
# falling back to the api's built-in dev defaults.

# admin credentials for the /admin panel (dev defaults, never reuse in prod)
ADMIN_USER=admin
ADMIN_PASSWORD=admin

# secret for signing JWT auth tokens (dev default, never reuse in prod)
JWT_SECRET=dev-secret-change-me

# keep "false" in dev: secure cookies require https
COOKIE_SECURE=false

# gin framework mode
GIN_MODE=debug
